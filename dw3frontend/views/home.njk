{% extends "layout.njk" %}

{% block content %}
  <header class="home-intro">
    <p class="page-kicker fw-semibold mb-2">Pastejo Rotacionado</p>
    <h1 class="h3 fw-bold mb-2">Painel principal</h1>
    <p class="text-secondary mb-0">Usuário conectado: <strong id="usuarioLogado"></strong></p>
  </header>

  <div class="row g-3">
    <div class="col-md-6">
      <a class="card page-card module-link text-reset h-100" href="/pastos">
        <div class="card-body p-0 d-flex">
          <span class="module-index" aria-hidden="true">01</span>
          <div class="p-4">
            <h2 class="h5 fw-semibold mb-1">Pastos</h2>
            <p class="text-secondary mb-0">Descrição e área total de cada pasto.</p>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-6">
      <a class="card page-card module-link text-reset h-100" href="/piquetes">
        <div class="card-body p-0 d-flex">
          <span class="module-index" aria-hidden="true">02</span>
          <div class="p-4">
            <h2 class="h5 fw-semibold mb-1">Piquetes</h2>
            <p class="text-secondary mb-0">Divisões de um pasto, com latitude e longitude.</p>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-6">
      <a class="card page-card module-link text-reset h-100" href="/animais">
        <div class="card-body p-0 d-flex">
          <span class="module-index" aria-hidden="true">03</span>
          <div class="p-4">
            <h2 class="h5 fw-semibold mb-1">Animais</h2>
            <p class="text-secondary mb-0">Nome e data de nascimento dos animais.</p>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-6">
      <a class="card page-card module-link text-reset h-100" href="/alocados">
        <div class="card-body p-0 d-flex">
          <span class="module-index" aria-hidden="true">04</span>
          <div class="p-4">
            <h2 class="h5 fw-semibold mb-1">Alocações</h2>
            <p class="text-secondary mb-0">Período em que cada animal fica em um piquete.</p>
          </div>
        </div>
      </a>
    </div>
  </div>
  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/home/vwHome.js"></script>
{% endblock %}
