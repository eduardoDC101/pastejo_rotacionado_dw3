<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or 'Pastejo Rotacionado' }}</title>
  <script>
    (function() {
      var tema = localStorage.getItem('pr_theme') === 'dark' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', tema);
      document.documentElement.setAttribute('data-bs-theme', tema);
    })();
  </script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="app-shell">
  {% if showNavbar %}
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
      <div class="container-xl">
        <a class="navbar-brand fw-semibold" href="/home">Pastejo Rotacionado</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegação">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav app-menu mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'pastos' %}active{% endif %}" href="/pastos">Pastos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'piquetes' %}active{% endif %}" href="/piquetes">Piquetes</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'animais' %}active{% endif %}" href="/animais">Animais</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'alocados' %}active{% endif %}" href="/alocados">Alocações</a>
            </li>
          </ul>
          <ul class="navbar-nav ms-lg-auto align-items-lg-center gap-2 mb-2 mb-lg-0">
            <li class="nav-item">
              <button type="button" class="theme-toggle-btn" id="btnToggleTheme" aria-pressed="false">
                <i class="bi bi-moon-stars-fill" id="themeIcon" aria-hidden="true"></i>
                <span id="themeLabel">Tema escuro</span>
              </button>
            </li>
            <li class="nav-item">
              <a class="nav-link nav-exit" href="/login">Sair</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  {% endif %}

  <main class="app-main">
    <div class="container-xl py-4 py-lg-5">
      {% block content %}{% endblock %}
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function() {
      function atualizarBotaoTema(tema) {
        var btn = document.getElementById('btnToggleTheme');
        var icon = document.getElementById('themeIcon');
        var label = document.getElementById('themeLabel');
        if (!btn) return;
        var escuro = tema === 'dark';
        btn.setAttribute('aria-pressed', escuro ? 'true' : 'false');
        if (icon) {
          icon.className = escuro ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
        }
        if (label) {
          label.textContent = escuro ? 'Tema claro' : 'Tema escuro';
        }
      }

      document.addEventListener('DOMContentLoaded', function() {
        var temaAtual = document.documentElement.getAttribute('data-theme') || 'light';
        atualizarBotaoTema(temaAtual);

        var btn = document.getElementById('btnToggleTheme');
        if (!btn) return;

        btn.addEventListener('click', function() {
          var proximo = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', proximo);
          document.documentElement.setAttribute('data-bs-theme', proximo);
          localStorage.setItem('pr_theme', proximo);
          atualizarBotaoTema(proximo);
        });
      });
    })();
  </script>
</body>
</html>
