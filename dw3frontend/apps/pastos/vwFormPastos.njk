{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <header class="page-header">
    <p class="page-kicker fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2" id="tituloFormulario">Formulário de pastos</h1>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <form id="frmPastos" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="pastoid" name="pastoid" value="0">

        <div class="row g-3">
          <div class="col-12 col-md-2 d-none" id="grupoId">
            <label for="idVisivel" class="form-label">ID</label>
            <input type="text" class="form-control" id="idVisivel" value="" disabled>
          </div>

          <div class="col-12 col-md-7">
            <label for="descricao" class="form-label">Descrição <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="descricao" name="descricao" maxlength="60" required>
          </div>

          <div class="col-12 col-md-3">
            <label for="areatotal" class="form-label">Área total (ha) <span class="text-danger">*</span></label>
            <input type="number" class="form-control" id="areatotal" name="areatotal" min="0.01" step="0.01" required>
          </div>
        </div>

        <div class="form-actions d-flex flex-column flex-sm-row gap-2">
          <button type="button" class="btn btn-primary d-none" id="btnInserirPasto">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarPasto" disabled>
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverPasto" disabled>
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/pastos" id="btnFecharPasto">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/pastos/vwFormPastos.js"></script>
{% endblock %}
