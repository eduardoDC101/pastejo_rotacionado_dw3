{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <div class="card page-card border-0">
    <div class="list-toolbar">
      <div>
        <p class="page-kicker fw-semibold mb-1">Cadastro</p>
        <h1 class="h4 fw-bold mb-1">Piquetes</h1>
        <p class="text-secondary mb-0">Piquetes ativos e o pasto ao qual pertencem.</p>
      </div>
      <a class="btn btn-primary" href="/piquetes/form?oper=Cr" id="btnNovoPiquete">Incluir novo piquete</a>
    </div>
    <div class="card-body p-4 pt-3">
      <div id="piquetesAlert" class="alert d-none" role="alert"></div>
      <p id="piquetesCarregando" class="text-secondary">Carregando piquetes...</p>

      <div id="piquetesListagem" class="d-none" data-servidor-dw3="{{ servidorDw3 }}">
        <div class="table-responsive">
          <table id="tblPiquetes" class="table table-striped table-hover align-middle w-100">
            <thead>
              <tr>
                <th>ID</th>
                <th>Descrição</th>
                <th>Pasto</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Operações</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script>
  <script src="/apps/piquetes/vwLstPiquetes.js"></script>
{% endblock %}
