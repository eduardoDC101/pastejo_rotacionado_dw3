{% extends "layout.njk" %}

{% block content %}
  <header class="page-header">
    <p class="page-kicker fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2" id="tituloFormulario">Formulário de animais</h1>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <form id="frmAnimais" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="animalid" name="animalid" value="0">

        <div class="row g-3">
          <div class="col-12 col-md-2 d-none" id="grupoId">
            <label for="idVisivel" class="form-label">ID</label>
            <input type="text" class="form-control" id="idVisivel" value="" disabled>
          </div>

          <div class="col-12 col-md-7">
            <label for="nome" class="form-label">Nome <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="nome" name="nome" maxlength="60" required>
          </div>

          <div class="col-12 col-md-3">
            <label for="datanasc" class="form-label">Data de nascimento <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="datanasc" name="datanasc" required>
          </div>
        </div>

        <div class="form-actions d-flex flex-column flex-sm-row gap-2">
          <button type="button" class="btn btn-primary d-none" id="btnInserirAnimal">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarAnimal" disabled>
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverAnimal" disabled>
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/animais" id="btnFecharAnimal">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/animais/vwFormAnimais.js"></script>
{% endblock %}
