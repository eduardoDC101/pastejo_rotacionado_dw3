{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css">

  <div class="card page-card border-0">
    <div class="list-toolbar">
      <div>
        <p class="page-kicker fw-semibold mb-1">Cadastro</p>
        <h1 class="h4 fw-bold mb-1">Animais</h1>
        <p class="text-secondary mb-0">Lista de animais cadastrados.</p>
      </div>
      <a class="btn btn-primary" href="/animais/form?oper=Cr" id="btnNovoAnimal">Novo animal</a>
    </div>
    <div class="card-body p-4 pt-3">
      <div id="animaisAlert" class="alert d-none" role="alert"></div>
      <p id="animaisCarregando" class="text-secondary">Carregando animais...</p>

      <div id="animaisListagem" class="d-none" data-servidor-dw3="{{ servidorDw3 }}">
        <div class="table-responsive">
          <table id="tblAnimais" class="table table-striped table-hover align-middle w-100">
            <thead>
              <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Data de nascimento</th>
                <th>Operações</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script>
  <script src="/apps/animais/vwLstAnimais.js"></script>
{% endblock %}
