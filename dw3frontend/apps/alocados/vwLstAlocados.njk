{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <div class="card page-card border-0">
    <div class="list-toolbar">
      <div>
        <p class="page-kicker fw-semibold mb-1">Movimentação</p>
        <h1 class="h4 fw-bold mb-1">Alocações</h1>
        <p class="text-secondary mb-0">Alocações ativas de animais em piquetes.</p>
      </div>
      <a class="btn btn-primary" href="/alocados/form?oper=Cr" id="btnNovoAlocado">Incluir nova alocação</a>
    </div>
    <div class="card-body p-4 pt-3">
      <div id="alocadosAlert" class="alert d-none" role="alert"></div>
      <p id="alocadosCarregando" class="text-secondary">Carregando alocações...</p>

      <div id="alocadosListagem" class="d-none" data-servidor-dw3="{{ servidorDw3 }}">
        <div class="table-responsive">
          <table id="tblAlocados" class="table table-striped table-hover align-middle w-100">
            <thead>
              <tr>
                <th>ID</th>
                <th>Animal</th>
                <th>Piquete</th>
                <th>Data de início</th>
                <th>Data final</th>
                <th>Operações</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script>
  <script src="/apps/alocados/vwLstAlocados.js"></script>
{% endblock %}
